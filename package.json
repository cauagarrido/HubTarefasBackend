{
  "name": "tarefas-backend",
  "version": "1.0.0",
  "description": "Backend RESTful para Hub de Tarefas & Central de Comunicação integrado ao Supabase (PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only scripts/test-api.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "supabase",
    "postgresql",
    "kanban",
    "chat"
  ],
  "author": "Cauã",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
